---
import Layout from '../layouts/Layout.astro';
import FloatingShapes from '../components/home-page/FloatingShapes.astro';
import Hero from '../components/home-page/Hero.astro';
import ValuePillars from '../components/home-page/ValuePillars.astro';
import Rooms from '../components/home-page/Rooms.astro';
import HowItWorks from '../components/home-page/HowItWorks.astro';
import Works from '../components/home-page/Works.astro';
import Pricing from '../components/home-page/Pricing.astro';
// --- Komponen Akhir ---
import FAQ from '../components/home-page/FAQ.astro';
import Location from '../components/home-page/Location.astro';
---

<Layout title="Mahalu Studio — Ruang Produksi Visual">
	<FloatingShapes />

	<div class="hero-visual-wrap relative overflow-hidden transition-colors duration-350 ease-in-out">
		<div class="grid-bg" aria-hidden="true" id="heroGrid"></div>
		<div class="grain" aria-hidden="true"></div>
		<div class="container-wrap pt-14 md:pt-28">
			<Hero />
		</div>
	</div>

	<!-- Tumpukan Section Utama -->
	<main class="container-wrap">
		<ValuePillars />
		<Rooms />
		<HowItWorks />
		<Works />
		<Pricing />
		<FAQ />
		<Location />
	</main>

	<!-- Script Interaksi -->
	<script>
		import { inView, animate, stagger } from "motion";

		const initShutterFlash = () => {
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (reduceMotion) return;

			const buttons = document.querySelectorAll(".btn-shutter");
			buttons.forEach((btn) => {
				btn.addEventListener("click", function (e: Event) {
					const mouseEvent = e as MouseEvent;
					const target = btn as HTMLElement;
					const rect = target.getBoundingClientRect();
					
					const x = (mouseEvent.clientX || rect.width / 2 + rect.left) - rect.left;
					const y = (mouseEvent.clientY || rect.height / 2 + rect.top) - rect.top;
					
					const flash = document.createElement("span");
					flash.className = "absolute rounded-full bg-[#fff8ee] opacity-50 pointer-events-none transform -translate-x-1/2 -translate-y-1/2 scale-0 animate-shutter-flash";
					
					const size = Math.max(rect.width, rect.height) * 0.6;
					flash.style.width = size + "px";
					flash.style.height = size + "px";
					flash.style.left = x + "px";
					flash.style.top = y + "px";
					
					target.appendChild(flash);
					flash.addEventListener("animationend", () => flash.remove());
				});
			});
		};

		const initGridParallax = () => {
			const heroWrap = document.querySelector(".hero-visual-wrap") as HTMLElement;
			const grid = document.getElementById("heroGrid");
			if (!heroWrap || !grid) return;
			
			let ticking = false;
			const update = () => {
				const rect = heroWrap.getBoundingClientRect();
				const wrapHeight = heroWrap.offsetHeight || 1;
				const progress = Math.min(Math.max(-rect.top / wrapHeight, 0), 1);
				const scale = 1 + progress * 0.55;
				grid.style.transform = `scale(${scale.toFixed(3)})`;
				ticking = false;
			};
			
			window.addEventListener("scroll", () => {
				if (!ticking) {
					window.requestAnimationFrame(update);
					ticking = true;
				}
			}, { passive: true });
			update();
		};

		const initScrollReveal = () => {
			inView(".sec-block", (info) => {
				const elements = info.target.querySelectorAll('.sec-anim');
				if (elements.length > 0) {
					animate(
						elements,
						{ y: [60, 0], opacity: [0, 1] },
						{ duration: 0.7, delay: stagger(0.15), easing: [0.22, 1, 0.36, 1] }
					);
				}
			}, { margin: "-100px" });
		};

		initShutterFlash();
		initGridParallax();
		initScrollReveal();
	</script>
</Layout>