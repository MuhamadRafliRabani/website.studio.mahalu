					<stop offset="100%" stop-color="#8a4a26" />
				</linearGradient>
			</defs>
			<rect x="8" y="30" width="80" height="50" rx="9" fill="url(#gradCamBody)" />
			<rect x="30" y="18" width="26" height="14" rx="4" fill="#8a4a26" />
			<circle cx="48" cy="55" r="19" fill="#6e4423" />
			<circle cx="48" cy="55" r="12" fill="none" stroke="#fff8ee" stroke-width="3" opacity="0.55" />
			<circle cx="74" cy="40" r="4" fill="#fff8ee" opacity="0.6" />
		</svg>
	</div>

	<div class="floaty floaty-film">
		<svg viewBox="0 0 70 100">
			<defs>
				<linearGradient id="gradFilm" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#e0a877" />
					<stop offset="100%" stop-color="#79431f" />
				</linearGradient>
			</defs>
			<rect x="6" y="4" width="58" height="92" rx="8" fill="url(#gradFilm)" />
			<g fill="#fff8ee" opacity="0.55">
				<rect x="13" y="12" width="9" height="9" rx="2" />
				<rect x="48" y="12" width="9" height="9" rx="2" />
				<rect x="13" y="30" width="9" height="9" rx="2" />
				<rect x="48" y="30" width="9" height="9" rx="2" />
				<rect x="13" y="48" width="9" height="9" rx="2" />
				<rect x="48" y="48" width="9" height="9" rx="2" />
				<rect x="13" y="66" width="9" height="9" rx="2" />
				<rect x="48" y="66" width="9" height="9" rx="2" />
				<rect x="13" y="84" width="9" height="9" rx="2" />
				<rect x="48" y="84" width="9" height="9" rx="2" />
			</g>
		</svg>
	</div>

	<div class="floaty floaty-softbox">
		<svg viewBox="0 0 100 100">
			<defs>
				<linearGradient id="gradSoftbox" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#f3d4a6" />
					<stop offset="100%" stop-color="#b4703b" />
				</linearGradient>
			</defs>
			<rect x="10" y="10" width="80" height="80" rx="10" fill="url(#gradSoftbox)" transform="rotate(6 50 50)" />
			<rect x="22" y="22" width="56" height="56" rx="6" fill="none" stroke="#fff8ee" stroke-width="2.5" opacity="0.5" transform="rotate(6 50 50)" />
		</svg>
	</div>

	<div class="floaty floaty-lens">
		<svg viewBox="0 0 80 80">
			<defs>
				<radialGradient id="gradLens" cx="40%" cy="35%" r="70%">
					<stop offset="0%" stop-color="#f0c793" />
					<stop offset="100%" stop-color="#8a4a26" />
				</radialGradient>
			</defs>
			<circle cx="40" cy="40" r="34" fill="url(#gradLens)" />
			<circle cx="40" cy="40" r="22" fill="#3a2416" />
			<circle cx="40" cy="40" r="13" fill="#6e4423" />
			<circle cx="34" cy="33" r="4" fill="#fff8ee" opacity="0.5" />
		</svg>
	</div>

	<div class="floaty floaty-tripod">
		<svg viewBox="0 0 78 100">
			<defs>
				<linearGradient id="gradTripod" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#dba374" />
					<stop offset="100%" stop-color="#6e4423" />
				</linearGradient>
			</defs>
			<rect x="27" y="10" width="24" height="14" rx="4" fill="url(#gradTripod)" />
			<g stroke="url(#gradTripod)" stroke-width="6" stroke-linecap="round">
				<line x1="39" y1="22" x2="12" y2="94" />
				<line x1="39" y1="22" x2="39" y2="94" />
				<line x1="39" y1="22" x2="66" y2="94" />
			</g>
		</svg>
	</div>

	<div class="floaty floaty-polaroid">
		<svg viewBox="0 0 76 90">
			<defs>
				<linearGradient id="gradPolaroid" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#fbeedb" />
					<stop offset="100%" stop-color="#e6c497" />
				</linearGradient>
			</defs>
			<rect x="4" y="4" width="68" height="82" rx="4" fill="url(#gradPolaroid)" transform="rotate(-5 38 45)" />
			<rect x="12" y="12" width="52" height="52" fill="#8a4a26" opacity="0.85" transform="rotate(-5 38 45)" />
		</svg>
	</div>

	<div class="floaty floaty-clapper">
		<svg viewBox="0 0 100 82">
			<defs>
				<linearGradient id="gradClapper" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#e2a877" />
					<stop offset="100%" stop-color="#6e4423" />
				</linearGradient>
			</defs>
			<rect x="6" y="24" width="88" height="52" rx="7" fill="url(#gradClapper)" />
			<path d="M6 24 18 6h14L20 24z" fill="#3a2416" />
			<path d="M32 24 44 6h14L46 24z" fill="#f0c793" />
			<path d="M58 24 70 6h14L72 24z" fill="#3a2416" />
			<rect x="16" y="42" width="68" height="6" fill="#fff8ee" opacity="0.4" />
			<rect x="16" y="56" width="68" height="6" fill="#fff8ee" opacity="0.4" />
		</svg>
	</div>

	<div class="floaty floaty-bulb">
		<svg viewBox="0 0 64 64">
			<defs>
				<radialGradient id="gradBulb" cx="40%" cy="30%" r="70%">
					<stop offset="0%" stop-color="#fce7c4" />
					<stop offset="100%" stop-color="#c9895a" />
				</radialGradient>
			</defs>
			<circle cx="32" cy="26" r="20" fill="url(#gradBulb)" />
			<rect x="24" y="44" width="16" height="12" rx="3" fill="#6e4423" />
			<path d="M28 20l6-8 2 2-4 6h6l-8 12-1-8h-4z" fill="#fff8ee" opacity="0.75" />
		</svg>
	</div>
</div>

<style>
	.floaty-shapes {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}
	
	@media (max-width: 1600px) {
		.floaty-shapes { display: none; }
	}
	
	.floaty {
		position: absolute;
		filter: drop-shadow(0 10px 18px rgba(34, 29, 24, 0.12));
		animation: floatBob 9s ease-in-out infinite;
	}
	
	:global([data-theme="dark"]) .floaty {
		filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.4));
		opacity: 0.92;
	}
	
	.floaty svg { display: block; width: 100%; height: 100%; }
	
	.floaty-ring { top: 620px; left: calc(50% - 760px); width: 128px; height: 128px; animation-duration: 12s; }
	.floaty-diamond { top: 340px; right: calc(50% - 730px); width: 58px; height: 58px; animation-duration: 7s; animation-delay: -1.2s; }
	.floaty-burst { top: 1620px; left: calc(50% - 790px); width: 116px; height: 116px; animation-duration: 13s; animation-delay: -4s; }
	.floaty-hourglass { top: 1820px; left: calc(50% - 640px); width: 62px; height: 62px; animation-duration: 8s; animation-delay: -2.5s; }
	.floaty-dome { top: 2560px; right: calc(50% - 770px); width: 150px; height: 112px; animation-duration: 15s; animation-delay: -6s; }
	.floaty-iris { top: 3400px; right: calc(50% - 690px); width: 84px; height: 84px; animation-duration: 10s; animation-delay: -3s; }
	.floaty-camera { top: 60px; left: calc(50% - 700px); width: 96px; height: 96px; animation-duration: 11s; animation-delay: -0.6s; }
	.floaty-film { top: 980px; right: calc(50% - 810px); width: 70px; height: 100px; animation-duration: 9.5s; animation-delay: -3.4s; }
	.floaty-softbox { top: 1260px; right: calc(50% - 660px); width: 100px; height: 100px; animation-duration: 12.5s; animation-delay: -5.2s; }
	.floaty-lens { top: 2080px; right: calc(50% - 750px); width: 80px; height: 80px; animation-duration: 10.5s; animation-delay: -1.8s; }
	.floaty-tripod { top: 2900px; left: calc(50% - 720px); width: 78px; height: 100px; animation-duration: 11.5s; animation-delay: -4.6s; }
	.floaty-polaroid { top: 3120px; left: calc(50% - 660px); width: 76px; height: 90px; animation-duration: 8.5s; animation-delay: -2s; }
	.floaty-clapper { top: 3820px; left: calc(50% - 780px); width: 100px; height: 82px; animation-duration: 13.5s; animation-delay: -6.5s; }
	.floaty-bulb { top: 4040px; right: calc(50% - 700px); width: 64px; height: 64px; animation-duration: 7.5s; animation-delay: -3.8s; }
	
	@keyframes floatBob {
		0%, 100% { transform: translate(0, 0) rotate(0deg); }
		50% { transform: translate(10px, -16px) rotate(6deg); }
	}
	
	@media (prefers-reduced-motion: reduce) {
		.floaty { animation: none !important; }
	}
</style>