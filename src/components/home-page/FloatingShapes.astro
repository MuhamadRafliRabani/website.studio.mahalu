---
---
<div class="floaty-shapes mt-20" aria-hidden="true">
	<div class="floaty floaty-ring">
		<svg viewBox="0 0 128 128">
			<defs>
				<linearGradient id="gradRing" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#f6d9ab" />
					<stop offset="100%" stop-color="#a15f26" />
				</linearGradient>
			</defs>
			<circle cx="64" cy="64" r="45" fill="none" stroke="url(#gradRing)" stroke-width="17" />
			<circle cx="64" cy="64" r="45" fill="none" stroke="#fff8ee" stroke-width="4" stroke-linecap="round" stroke-dasharray="22 261" opacity="0.55" transform="rotate(-52 64 64)" />
		</svg>
	</div>

	<div class="floaty floaty-diamond">
		<svg viewBox="0 0 58 58">
			<defs>
				<linearGradient id="gradDiamond" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#eda172" />
					<stop offset="100%" stop-color="#9a5324" />
				</linearGradient>
			</defs>
			<rect x="12" y="12" width="34" height="34" rx="8" fill="url(#gradDiamond)" transform="rotate(45 29 29)" />
			<rect x="12" y="12" width="34" height="15" rx="6" fill="#fff8ee" opacity="0.28" transform="rotate(45 29 29)" />
		</svg>
	</div>

	<div class="floaty floaty-burst">
		<svg viewBox="0 0 116 116">
			<defs>
				<radialGradient id="gradBurst" cx="35%" cy="30%" r="75%">
					<stop offset="0%" stop-color="#f0b48c" />
					<stop offset="100%" stop-color="#b4653a" />
				</radialGradient>
			</defs>
			<circle cx="42" cy="42" r="30" fill="url(#gradBurst)" />
			<circle cx="74" cy="42" r="30" fill="url(#gradBurst)" />
			<circle cx="42" cy="74" r="30" fill="url(#gradBurst)" />
			<circle cx="74" cy="74" r="30" fill="url(#gradBurst)" />
			<circle cx="58" cy="58" r="13" fill="#fff8ee" opacity="0.5" />
		</svg>
	</div>

	<div class="floaty floaty-hourglass">
		<svg viewBox="0 0 62 84">
			<defs>
				<linearGradient id="gradHour" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#c99a6b" />
					<stop offset="100%" stop-color="#6e4423" />
				</linearGradient>
			</defs>
			<path d="M9 6h44a5 5 0 013.6 8.5L34.4 38a3 3 0 000 4l22.2 23.5A5 5 0 0153 74H9a5 5 0 01-3.6-8.5L27.6 42a3 3 0 000-4L5.4 14.5A5 5 0 019 6z" fill="url(#gradHour)" />
			<rect x="9" y="6" width="44" height="9" rx="4" fill="#fff8ee" opacity="0.3" />
		</svg>
	</div>

	<div class="floaty floaty-dome">
		<svg viewBox="0 0 150 112">
			<defs>
				<linearGradient id="gradDome" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#f4e2c4" />
					<stop offset="100%" stop-color="#c9895a" />
				</linearGradient>
			</defs>
			<path d="M8 108a67 67 0 01134 0z" fill="url(#gradDome)" />
			<ellipse cx="75" cy="48" rx="24" ry="13" fill="#fff8ee" opacity="0.32" />
		</svg>
	</div>

	<div class="floaty floaty-iris">
		<svg viewBox="0 0 84 84">
			<defs>
				<linearGradient id="gradIris" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#e3a273" />
					<stop offset="100%" stop-color="#8a4a26" />
				</linearGradient>
			</defs>
			<polygon points="42,4 76,23 76,61 42,80 8,61 8,23" fill="url(#gradIris)" />
			<circle cx="42" cy="42" r="13" fill="none" stroke="#fff8ee" stroke-width="3" opacity="0.6" />
		</svg>
	</div>

	<div class="floaty floaty-camera">
