---
import ApertureIcon from './ApertureIcon.astro';
import ShutterIcon from './ShutterIcon.astro';
---
<section class="sec-block" id="karya">
	<div class="kicker sec-anim">
		<ApertureIcon />
		<span>Portofolio</span>
	</div>
	
	<div class="mb-[36px] sec-anim">
		<h2 class="font-display text-[26px] font-bold tracking-tight mb-[8px]">Hasil produksi di studio ini</h2>
		<p class="text-text-muted text-[15px] max-w-[560px] font-body">
			Sebagian karya klien yang dikerjakan di Studio 01 dan 02.
		</p>
	</div>
	
	<div class="grid grid-cols-1 md:grid-cols-3 gap-[18px] sec-anim">
		<!-- Work 01 -->
		<div class="group bg-card backdrop-blur-[14px] border border-border rounded-[8px] overflow-hidden card-hover">
			<div class="relative h-[250px] bg-bg-soft flex items-center justify-center text-text-dim text-[13px] overflow-hidden focus-frame transition-colors duration-350">
				<!-- Efek Zoom-in Gambar -->
				<img src="/assets/image/EXP-ONE.jpg" alt="Koleksi Autumn/Winter 2026" class="absolute inset-0 w-full h-full object-cover block transition-transform duration-[600ms] ease-out group-hover:scale-[1.045] object-[50%_73%]" />
				<span class="fc fc-tl" aria-hidden="true"></span><span class="fc fc-tr" aria-hidden="true"></span>
				<span class="fc fc-bl" aria-hidden="true"></span><span class="fc fc-br" aria-hidden="true"></span>
				<!-- Shutter Icon Reveal -->
				<span class="absolute top-[12px] right-[12px] w-[26px] h-[26px] rounded-full bg-scrim text-accent flex items-center justify-center opacity-0 scale-[0.6] -rotate-[25deg] transition-all duration-300 ease-out z-20 group-hover:opacity-100 group-hover:scale-100 group-hover:rotate-0 max-md:opacity-100 max-md:scale-100 max-md:rotate-0 max-md:w-[24px] max-md:h-[24px] max-md:top-[8px] max-md:right-[8px] max-md:bg-accent max-md:text-[#fff8ee] max-md:shadow-[0_2px_6px_rgba(0,0,0,0.25)]">
					<ShutterIcon />
				</span>
			</div>
			<div class="p-[16px_18px]">
				<p class="inline-block text-[11px] text-accent bg-accent-soft px-[9px] py-[3px] rounded-full mb-[8px] transition-colors font-title font-bold uppercase tracking-wide">Studio 01</p>
				<p class="text-[15px] font-semibold font-title">Koleksi Autumn/Winter 2026</p>
			</div>
		</div>

		<!-- Work 02 -->
		<div class="group bg-card backdrop-blur-[14px] border border-border rounded-[8px] overflow-hidden card-hover">
			<div class="relative h-[250px] bg-bg-soft flex items-center justify-center text-text-dim text-[13px] overflow-hidden focus-frame transition-colors duration-350">
				<img src="/assets/image/EXP-TEN.jpg" alt="Lumière Hydrating Series" class="absolute inset-0 w-full h-full object-cover block transition-transform duration-[600ms] ease-out group-hover:scale-[1.045] object-[50%_46%]" />
				<span class="fc fc-tl" aria-hidden="true"></span><span class="fc fc-tr" aria-hidden="true"></span>
				<span class="fc fc-bl" aria-hidden="true"></span><span class="fc fc-br" aria-hidden="true"></span>
				<span class="absolute top-[12px] right-[12px] w-[26px] h-[26px] rounded-full bg-scrim text-accent flex items-center justify-center opacity-0 scale-[0.6] -rotate-[25deg] transition-all duration-300 ease-out z-20 group-hover:opacity-100 group-hover:scale-100 group-hover:rotate-0 max-md:opacity-100 max-md:scale-100 max-md:rotate-0 max-md:w-[24px] max-md:h-[24px] max-md:top-[8px] max-md:right-[8px] max-md:bg-accent max-md:text-[#fff8ee] max-md:shadow-[0_2px_6px_rgba(0,0,0,0.25)]">
					<ShutterIcon />
				</span>
			</div>
			<div class="p-[16px_18px]">
				<p class="inline-block text-[11px] text-accent bg-accent-soft px-[9px] py-[3px] rounded-full mb-[8px] transition-colors font-title font-bold uppercase tracking-wide">Studio 01</p>
				<p class="text-[15px] font-semibold font-title">Lumière Hydrating Series</p>
			</div>
		</div>

		<!-- Work 03 -->
		<div class="group bg-card backdrop-blur-[14px] border border-border rounded-[8px] overflow-hidden card-hover">
			<div class="relative h-[250px] bg-bg-soft flex items-center justify-center text-text-dim text-[13px] overflow-hidden focus-frame transition-colors duration-350">
				<img src="/assets/image/EXP-FOUR.jpg" alt="Natural Portrait" class="absolute inset-0 w-full h-full object-cover block transition-transform duration-[600ms] ease-out group-hover:scale-[1.045] " />
				<span class="fc fc-tl" aria-hidden="true"></span><span class="fc fc-tr" aria-hidden="true"></span>
				<span class="fc fc-bl" aria-hidden="true"></span><span class="fc fc-br" aria-hidden="true"></span>
				<span class="absolute top-[12px] right-[12px] w-[26px] h-[26px] rounded-full bg-scrim text-accent flex items-center justify-center opacity-0 scale-[0.6] -rotate-[25deg] transition-all duration-300 ease-out z-20 group-hover:opacity-100 group-hover:scale-100 group-hover:rotate-0 max-md:opacity-100 max-md:scale-100 max-md:rotate-0 max-md:w-[24px] max-md:h-[24px] max-md:top-[8px] max-md:right-[8px] max-md:bg-accent max-md:text-[#fff8ee] max-md:shadow-[0_2px_6px_rgba(0,0,0,0.25)]">
					<ShutterIcon />
				</span>
			</div>
			<div class="p-[16px_18px]">
				<p class="inline-block text-[11px] text-accent bg-accent-soft px-[9px] py-[3px] rounded-full mb-[8px] transition-colors font-title font-bold uppercase tracking-wide">Studio 02</p>
				<p class="text-[15px] font-semibold font-title">The Craftsman Editorial</p>
			</div>
		</div>
	</div>
</section>